# Ejemplo exclusivamente documental. No copiar valores de secretos a Git.
DB_USER=horizonst
DB_PASSWORD=replace_in_protected_env
DB_NAME=horizonst
COLD_COMPLIANCE_DB_NAME=cold_compliance

# Debe obtenerse con `docker network inspect horizonst-production`; no se presupone una subred.
TRUSTED_PROXY_IP=replace_with_exact_bridge_gateway

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
CORS_ALLOWED_ORIGINS=
HARDWARE_MANAGER_PORT=3000

MQTT_USER=existing_operational_username
MQTT_PASS=existing_protected_password
MQTT_RAW_RETENTION_HOURS=48
MQTT_MAINTENANCE_INTERVAL_MS=60000
MQTT_MAINTENANCE_BATCH_SIZE=10000
INTERNAL_SERVICE_RATE_LIMIT_PER_MINUTE=120

GATEWAY_COMMAND_TIMEOUT_MS=8000
GATEWAY_COMMAND_SWEEP_INTERVAL_MS=5000
B5_SESSION_PASSWORD=replace_in_protected_env
B5_CONNECT_TIMEOUT_MS=12000
B5_ACTION_TIMEOUT_MS=8000

# Mantener false hasta completar migraciones, principal de servicio, ACL y validación local.
HARDWARE_MANAGER_ENABLED=false
HARDWARE_MANAGER_SERVICE_TOKEN=replace_in_protected_env
HARDWARE_MANAGER_TIMEOUT_MS=3000
HARDWARE_MANAGER_COMMAND_TIMEOUT_MS=20000
HARDWARE_MANAGER_B5_CONFIGURATION_TIMEOUT_MS=45000
HARDWARE_MANAGER_MQTT_TOPIC_REFRESH_MS=30000
HARDWARE_MANAGER_CACHE_TTL_MS=30000
HARDWARE_MANAGER_CACHE_ERROR_TTL_MS=5000

COLD_MQTT_SUB_TOPICS=
PRESENCE_RSSI_ENTRY_MARGIN_DB=5
PRESENCE_HEARTBEAT_RETENTION_DAYS=7
PRESENCE_MAINTENANCE_INTERVAL_MS=60000
PRESENCE_MAINTENANCE_BATCH_SIZE=10000
SYNC_QUEUE_SYNCED_RETENTION_HOURS=24
TAG_ALARM_BLE_SESSION_TTL_MS=120000
TAG_CONTROL_GATEWAY_STRATEGY=hybrid

BACKEND_MAIL_ENABLED=false
COLD_MAIL_ENABLED=true
COLD_MAIL_HOST=mail.horizonst.es
COLD_MAIL_PORT=465
COLD_MAIL_SECURE=true
COLD_MAIL_USER=replace_in_protected_env
COLD_MAIL_PASSWORD=replace_in_protected_env
COLD_MAIL_FROM=no_reply@horizonst.es
COLD_MAIL_EHLO_DOMAIN=horizonst.es
COLD_MAIL_TLS_REJECT_UNAUTHORIZED=true
COLD_APP_BASE_URL=https://horneo.horizonst.es

STORE_CORS_ORIGIN=https://horizonst.es
STORE_PUBLIC_BASE_URL=https://horizonst.es
STORE_JWT_SECRET=replace_in_protected_env
STORE_ACCESS_TOKEN_TTL=15m
STORE_REFRESH_TOKEN_TTL=30d
STORE_PASSWORD_RESET_TTL=1h
STORE_EMAIL_VERIFICATION_TTL=24h
STORE_MAIL_ENABLED=false
STORE_MAIL_HOST=mail.horizonst.es
STORE_MAIL_PORT=465
STORE_MAIL_SECURE=true
STORE_MAIL_USER=replace_in_protected_env
STORE_MAIL_PASSWORD=replace_in_protected_env
STORE_MAIL_FROM=no_reply@horizonst.es
STORE_MAIL_EHLO_DOMAIN=horizonst.es
STORE_MAIL_TLS_REJECT_UNAUTHORIZED=true
STORE_MAIL_COMMERCIAL_TO=comercial@horizonst.es
STORE_APPCC_GUIDE_URL=https://horizonst.es/recursos/guia-appcc-2026.pdf
